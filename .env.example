# ─── LLM / OpenAI (embeddings + RAG + extração de PDF) ───
API_OPENAI_KEY=sk-...

# ─── Supabase ───
# Atenção: config.py lê a chave PUBLIC_SUBASE_URL (sem o "P" de "SUPABASE")
PUBLIC_SUBASE_URL=https://xxxx.supabase.co/rest/v1/
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_PASSWORD=...

# ─── Qdrant ───
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=oraculo_financeiro
API_KEY_QDRANT=...
CLUSTER_ENDPOINT_QDRANT=https://xxxx.qdrant.io

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── MLflow ───
MLFLOW_TRACKING_URI=./mlruns

# ─── App ───
LOG_LEVEL=INFO
ENV=development
